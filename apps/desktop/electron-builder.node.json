{
  "productName": "NodeVault",
  "appId": "local.nodevault.desktop",
  "electronVersion": "43.5.0",
  "electronDist": "../../node_modules/electron/dist",
  "beforeBuild": "scripts/after-pack-node.js",
  "afterPack": "scripts/after-pack-node.js",
  "directories": {
    "app": "build-nodevault",
    "output": "dist-node"
  },
  "asarUnpack": ["**/*.node"],
  "files": [
    "**/*",
    "!**/*.map",
    {
      "from": "../desktop_native/napi",
      "to": "node_modules/@bitwarden/desktop-napi",
      "filter": ["package.json", "index.js", "desktop_napi.win32-x64-msvc.node"]
    }
  ],
  "portable": {
    "artifactName": "NodeVault.exe"
  },
  "win": {
    "icon": "src/images/icon_node.ico",
    "signAndEditExecutable": false,
    "extraFiles": [
      { "from": "../../LICENSE.txt", "to": "LICENSE.txt" },
      { "from": "../../LICENSE_GPL.txt", "to": "LICENSE_GPL.txt" },
      { "from": "../../LICENSE_BITWARDEN.txt", "to": "LICENSE_BITWARDEN.txt" },
      {
        "from": "desktop_native/dist/bitwarden_chromium_import_helper.win32-x64.exe",
        "to": "bitwarden_chromium_import_helper.exe"
      }
    ]
  }
}
